# Скопируйте в .env в корне репозитория и в apps/api/.env
# Не коммитьте файлы с реальными секретами.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://istighfar:istighfar@localhost:5432/istighfar?schema=public

# Минимум 32 символа. В production сгенерируйте случайную строку.
JWT_ACCESS_SECRET=change-me-to-a-random-string-with-32-plus-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Через запятую, без пробелов. Origin фронтенда.
# Хост страницы и API должен совпадать, иначе браузер не отправит refresh cookie.
CORS_ORIGINS=http://localhost:5173

# Для локального HTTP: secure=false и SameSite=Lax.
# Для production, если фронт и API на разных сайтах: secure=true и SameSite=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=api.example.com

# Приглашение действует 7 суток.
INVITE_TTL_HOURS=168

# Адрес API для Vite. Должен быть доступен из браузера.
VITE_API_URL=http://localhost:3000
